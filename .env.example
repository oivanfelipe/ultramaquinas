# Composio — key correta: COMPOSIO_API_KEY (tipo ak_..., Platform → API Keys)
# com permissão "tool_execution" = write. NÃO use a consumer key ck_... (For You).
# Nunca versione o valor real. Cloud: variável do ambiente. Local: copie para .env (ignorado pelo git).
COMPOSIO_API_KEY=ak_...

# GA4 property ID (sem o prefixo "properties/")
GA4_PROPERTY_ID=326709572

# GSC site URL
GSC_SITE_URL=https://www.ultramaquinas.com.br/
