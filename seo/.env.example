# Copie este arquivo para .env e preencha os valores.
# O arquivo .env não é versionado (está no .gitignore).

# Google Custom Search API key — para busca de concorrentes (etapa 3)
GOOGLE_API_KEY=your-google-custom-search-api-key

# Google Custom Search Engine ID — configurado em cse.google.com
GOOGLE_CSE_ID=f5f6adde74f164ab6

# Google Analytics Data API key
GOOGLE_ANALYTICS_API_KEY=your-google-analytics-api-key

# Google Analytics 4 Property ID (ex: properties/123456789)
# Obter em: analytics.google.com → Admin → Property → Property ID
GOOGLE_ANALYTICS_PROPERTY_ID=properties/your-property-id

# Service Account JSON para Google Search Console
# Caminho relativo ao diretório seo/ ou absoluto
GSC_SERVICE_ACCOUNT_FILE=gsc_credentials.json

# Anthropic (Claude) API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
